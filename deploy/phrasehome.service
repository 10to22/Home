[Unit]
Description=phrasehome - wake-word-free voice commands
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=@USER@
SupplementaryGroups=audio
WorkingDirectory=@DIR@
ExecStart=@DIR@/.venv/bin/phrasehome -c @DIR@/config.yaml run
Restart=always
# Lets the speaker hub record music from the user's PipeWire session
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
RestartSec=5
# Secrets: ANTHROPIC_API_KEY, PHRASEHOME_TOKEN, HA_TOKEN... (optional file)
EnvironmentFile=-@DIR@/.env

[Install]
WantedBy=multi-user.target
